{
  "rules": {
    // 공휴일 정보는 누구나 읽을 수 있고, Cloud Function(관리자 권한)만 씁니다.
    "holidayInfo": {
      ".read": true,
      ".write": false
    },
    // 사용자 데이터는 본인(익명 로그인 uid)만 읽고 쓸 수 있습니다.
    "$uid": {
      ".read": "auth != null && auth.uid === $uid",
      ".write": "auth != null && auth.uid === $uid"
    }
  }
}
